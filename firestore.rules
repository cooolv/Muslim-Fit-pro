rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /logs/{id} {
      allow read: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid
        && request.resource.data.reps is int && request.resource.data.reps <= 1000;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    match /sets/{id} {
      allow read: if request.auth != null &&
        (resource.data.public == true || resource.data.owner == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.owner == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() < 60 &&
        request.resource.data.ids.size() <= 50;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
